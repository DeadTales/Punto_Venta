# Conexión directa a PostgreSQL en Supabase mediante SQLAlchemy y asyncpg.
DATABASE_MODE=cloud
# Sustituir TU_PROYECTO y CAMBIAR_PASSWORD con los datos de Connect > Direct connection.
# Escribir la URL sin barras invertidas. SSL obligatorio.
# Codificar caracteres especiales de la contraseña para usarlos dentro de una URL.
DATABASE_URL=postgresql+asyncpg://postgres:CAMBIAR_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres?ssl=require

# Conexiones disponibles por proceso del backend.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Sesiones del POS: JWT_SECRET es obligatorio, con al menos 32 caracteres aleatorios.
# Se genera para esta aplicación y se conserva en backend/.env.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Datos del ticket y desglose de impuesto incluido en los precios del catálogo.
POS_BUSINESS_NAME=Punto · Sistema POS
# Configura la tasa que corresponda a tu operación; 0 desactiva el desglose.
# Ejemplo de una tasa del 16 por ciento: 0.16. El valor predeterminado es 0.
POS_TAX_RATE=0

# Alternativa opcional: activar DATABASE_MODE=local y definir esta variable.
# LOCAL_DATABASE_URL=postgresql+asyncpg://pos:CAMBIAR_PASSWORD@127.0.0.1:5432/pos

# Sincronización opcional desde una API local hacia el backend central.
# Dejar URL y clave vacías para la configuración de conexión directa actual.
# SYNC_API_URL corresponde a la API FastAPI central.
SYNC_API_URL=
# Mismo secreto aleatorio de al menos 32 caracteres en API local y central.
SYNC_KEY=
SYNC_INTERVAL=30
