# cloud: API central; local: API de la sucursal, siempre sobre PostgreSQL local.
DATABASE_MODE=cloud
DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/postgres?ssl=require
LOCAL_DATABASE_URL=postgresql+asyncpg://pos:CAMBIAR_PASSWORD@127.0.0.1:5432/pos
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# URL HTTPS del backend central, no URL de PostgreSQL. Vacía = sincronización desactivada.
SYNC_API_URL=
# Mismo secreto aleatorio de al menos 32 caracteres en API local y central.
SYNC_KEY=
SYNC_INTERVAL=30
